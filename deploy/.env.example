# Copy to deploy/.env and fill in. deploy/.env is git-ignored.

# A Turbo appsettings.Development.json to start from (copied into vendor/turbo-cloud once).
# Leave empty to run on vendor/turbo-cloud/appsettings.json plus the values below.
WB_TURBO_SETTINGS=

# The values below override the settings file; leave one empty to keep what the file says.

# MariaDB/MySQL connection for Turbo's database, for example
# Server=127.0.0.1;Port=3306;Database=turbo;User=turbo;Password=...;
WB_DB_CONNECTION=

# The player who owns the hotel (joins the admin group; the log prints their panel setup link).
WB_OWNER_NAME=

# Where clients reach Turbo's gamedata host, which also serves the plugin's client module.
# Leave empty: deploy/client.sh passes /gamedata on the client's own origin to the gamedata host.
WB_GAMEDATA_URL=

# Where deploy/client.sh passes /gamedata on to. Empty means http://127.0.0.1:8094.
WB_GAMEDATA_PROXY=

# Where Turbo keeps its downloaded assets (about 400 MB). Point it at an existing folder to reuse it.
WB_ASSETS_DIR=
